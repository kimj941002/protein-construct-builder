# Caddy 리버스 프록시 — Reflex 앱(프론트 3000 + 백엔드 8000)을 한 포트(8080)로 합친다.
# Cloudflare Tunnel 이 이 8080 으로 연결한다. TLS 는 Cloudflare 가 처리하므로 여기선 http.
#
# 사용: caddy run --config deploy/Caddyfile

:8080 {
    # 백엔드(웹소켓/이벤트/업로드/헬스/라우트)는 Reflex 백엔드(8000)로.
    # Reflex 프론트가 호출하는 백엔드 경로 전부 포함해야 연결이 된다.
    @backend path /_event* /_upload* /ping /_health /_all_routes /auth-codespace*
    reverse_proxy @backend localhost:8000 {
        # 웹소켓 업그레이드 헤더 전달
        header_up Host {host}
        header_up X-Forwarded-For {remote_host}
    }

    # 그 외 전부는 프론트엔드(3000)로
    reverse_proxy localhost:3000
}
