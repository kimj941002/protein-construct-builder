# Streamlit Cloud / 로컬 Secrets 설정 예시
# ─────────────────────────────────────────────────────────────────
# 이 파일은 템플릿입니다. 실제 키를 넣지 마세요!
#
# [로컬 사용법]
#   이 파일을 같은 폴더에 secrets.toml 로 복사한 뒤 실제 값으로 채웁니다.
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   secrets.toml 은 .gitignore 에 등록되어 GitHub 에 올라가지 않습니다.
#
# [Streamlit Cloud 배포]
#   대시보드 → 앱 → Settings → Secrets 에 아래 내용을 붙여넣고 값 채우기.
# ─────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY = "sk-ant-여기에_실제_API_키를_입력하세요"

# ─────────────────────────────────────────────────────────────────
# Supabase (Postgres) 연결  — UNIFIED_MIGRATION_PLAN.md §3
# Supabase 대시보드 → Connect → Connection string 에서 복사.
# [YOUR-PASSWORD] 자리에 Stage 0 에서 정한 DB 비밀번호를 넣으세요.
# ─────────────────────────────────────────────────────────────────

# 앱 런타임용: Transaction pooler (포트 6543) — 메인 연결
SUPABASE_DB_URL = "postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"

# 일회성 데이터 이전 스크립트용: Direct connection (포트 5432)
# (런타임에는 쓰지 않음. 데이터 이전이 끝나면 비워둬도 됩니다.)
SUPABASE_DB_URL_DIRECT = "postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
