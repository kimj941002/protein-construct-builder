# Streamlit Cloud / 로컬 Secrets 설정 예시
# ─────────────────────────────────────────────────────────────────
# 이 파일은 템플릿입니다. 실제 키를 넣지 마세요!
#
# [로컬 사용법]
#   이 파일을 같은 폴더에 secrets.toml 로 복사한 뒤 실제 값으로 채웁니다.
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   secrets.toml 은 .gitignore 에 등록되어 GitHub 에 올라가지 않습니다.
#
# [Streamlit Cloud 배포]
#   대시보드 → 앱 → Settings → Secrets 에 아래 내용을 붙여넣고 값 채우기.
# ─────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY = "sk-ant-여기에_실제_API_키를_입력하세요"

# ─────────────────────────────────────────────────────────────────
# Supabase (Postgres) 연결 — 컴포넌트 방식 (db_config.py 가 URL 조립).
# 비밀번호는 "원본 그대로" (인코딩 불필요). Supabase → Connect 에서 ref/host 확인.
# ─────────────────────────────────────────────────────────────────
SUPABASE_DB_PASSWORD = "실제_DB_비밀번호_원본_그대로"
SUPABASE_PROJECT_REF = "프로젝트_ref"                # 예: izgdypalbnauzidoffyx
SUPABASE_POOLER_HOST = "aws-1-ap-northeast-2.pooler.supabase.com"

# ─────────────────────────────────────────────────────────────────
# 배포(링크 공유) 시 접속 비밀번호 — 이 값을 아는 사람만 입장 (deploy/DEPLOY.md).
# 비우면 게이트 비활성(로컬 개발).
# ─────────────────────────────────────────────────────────────────
APP_PASSWORD = ""
